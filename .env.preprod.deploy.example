# Compose interpolation only — nothing here reaches the application.
# Sets what preprod changes; compose.prod.yaml's defaults cover the rest.

# Generated by the certs service. In prod this is the real chain instead,
# e.g. /etc/letsencrypt/live/<domain>.
TLS_CERT_DIR=./docker/nginx/certs/local

# Docker's iptables rules bypass UFW, so a preprod stack left on 0.0.0.0 is
# reachable from the network.
NGINX_BIND=127.0.0.1
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
