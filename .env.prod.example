APP_NAME=Laravel
APP_ENV=production
APP_KEY=your_app_key
APP_DEBUG=false
APP_URL=http://localhost:8000

# Encryption in transit to the database, shown for pgsql. Paths are examples;
# mount the material read-only. sslcert/sslkey are client authentication and
# are optional — sslmode plus sslrootcert is what encrypts and verifies.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/path/to/certs/root.crt
# DB_SSLCERT=/path/to/certs/client.crt
# DB_SSLKEY=/path/to/certs/client.key
#
# mysql:  MYSQL_ATTR_SSL_CA=/path/to/certs/ca.pem — mapped out of the box.
# sqlsrv: DB_ENCRYPT=yes, DB_TRUST_SERVER_CERTIFICATE=false — uncomment the
#         matching keys in config/database.php first.

LOG_CHANNEL=stderr
LOG_LEVEL=info

SESSION_LIFETIME=15
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
