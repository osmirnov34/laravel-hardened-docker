# Compose interpolation only — nothing here reaches the application.
# docker compose --env-file .env.deploy -f compose.yaml -f compose.prod.yaml up -d

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

NGINX_CPUS=1.0
NGINX_MEM=128m
NGINX_PIDS=128

PHP_CPUS=1.0
PHP_MEM=768m
PHP_PIDS=128

LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
